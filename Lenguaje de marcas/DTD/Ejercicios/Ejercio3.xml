<!DOCTYPE MAPA_RPG [
<!ELEMENT MAPA_RPG (ENTIDAD+)>
<!ELEMENT ENTIDAD (ESTADISTICAS, INVENTARIO?, HABILIDADES, POSICION, HISTORIA)>
<!ELEMENT ESTADISTICAS (FUERZA, AGILIDAD, INTELIGENCIA)>
<!ELEMENT FUERZA (#PCDATA)>
<!ELEMENT AGILIDAD (#PCDATA)>
<!ELEMENT INTELIGENCIA (#PCDATA)>
<!ELEMENT INVENTARIO (ITEM*)>
<!ELEMENT ITEM (#PCDATA)>
<!ELEMENT HABILIDADES (PODER*)>
<!ELEMENT PODER (#PCDATA)>
<!ELEMENT POSICION (COORDENADAS)>
<!ELEMENT COORDENADAS (X, Y)>
<!ELEMENT X (#PCDATA)>
<!ELEMENT Y (#PCDATA)>
<!ELEMENT HISTORIA (#PCDATA)>
<!ATTLIST ENTIDAD
VIDA CDATA "100"
CLASE (GUERRERO | MAGO | ARQUERO) #REQUIRED>
]>
<MAPA_RPG>
    <ENTIDAD VIDA="150" CLASE="GUERRERO">
        <ESTADISTICAS>
            <FUERZA>20</FUERZA>
            <AGILIDAD>15</AGILIDAD>
            <INTELIGENCIA>10</INTELIGENCIA>
        </ESTADISTICAS>
        <INVENTARIO>
            <ITEM>Espada</ITEM>
            <ITEM>Escudo</ITEM>
        </INVENTARIO>
        <HABILIDADES>
            <PODER>Golpe Fuerte</PODER>
            <PODER>Defensa Total</PODER>
        </HABILIDADES>
        <POSICION>
            <COORDENADAS>
                <X>100</X>
                <Y>200</Y>
            </COORDENADAS>
        </POSICION>
        <HISTORIA>Un valiente guerrero en busca de aventuras.</HISTORIA>
    </ENTIDAD>
</MAPA_RPG>