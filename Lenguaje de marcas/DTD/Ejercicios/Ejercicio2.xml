<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ACADEMIA[
<!ELEMENT ACADEMIA (CURSO+)>
<!ELEMENT CURSO (TITULO_CURSO, DESCRIPCION, PROFESOR*, TEMARIO, EXAMEN_FINAL?)>
<!ELEMENT TITULO_CURSO (#PCDATA)>
<!ELEMENT DESCRIPCION (NEGRITA*)>
<!ELEMENT NEGRITA (#PCDATA)>
<!ELEMENT PROFESOR (#PCDATA)>
<!ELEMENT TEMARIO (MODULO*)>
<!ELEMENT MODULO (VIDEO+)>
<!ELEMENT VIDEO (#PCDATA)>
<!ELEMENT EXAMEN_FINAL (#PCDATA)>
<!ATTLIST CURSO
NIVEL (BÁSICO | INTERMEDIO | AVANZADO) #REQUIRED>
<!ATTLIST DESCRIPCIÓN NEGRITA CDATA #REQUIRED>
]>
<ACADEMIA>
    <CURSO NIVEL="BÁSICO">
        <TITULO_CURSO></TITULO_CURSO>
        <DESCRIPCION>
            <NEGRITA></NEGRITA>
        </DESCRIPCION>
        <PROFESOR></PROFESOR>
        <TEMARIO>
            <MODULO>
                <VIDEO></VIDEO>
            </MODULO>
        </TEMARIO>
        <EXAMEN_FINAL></EXAMEN_FINAL>
    </CURSO>
</ACADEMIA>