<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE HOSPITAL [
<!ELEMENT HOSPITAL (PACIENTE+)>
<!ELEMENT PACIENTE (NOMBRE_COMPLETO, FECHA_INGRESO, DIAGNOSTICO?, MEDICO_ASIGNADO, HABITACION)>
<!ELEMENT NOMBRE_COMPLETO (#PCDATA)>
<!ELEMENT FECHA_INGRESO (#PCDATA)>
<!ELEMENT DIAGNOSTICO (#PCDATA)>
<!ELEMENT MEDICO_ASIGNADO (#PCDATA)>
<!ELEMENT HABITACION (#PCDATA)>
<!ATTLIST PACIENTE 
ID_PACIENTE CDATA #REQUIRED
TIPO_SEGURO (PUBLICO | PRIVADO) #REQUIRED>
<!ATTLIST FECHA_INGRESO DATE CDATA #REQUIRED>
<!ATTLIST MEDICO_ASIGNADO
COLEGIADO CDATA #REQUIRED>
<!ATTLIST HABITACION NUMEROCAMA CDATA #REQUIRED NUMEROHABITACION CDATA #REQUIRED>
]>
<HOSPITAL>  
<PACIENTE ID_PACIENTE="12345" TIPO_SEGURO="PUBLICO">
    <NOMBRE_COMPLETO>Juan Perez</NOMBRE_COMPLETO>
    <FECHA_INGRESO DATE="2024-06-15"></FECHA_INGRESO>
    <DIAGNOSTICO>Gripe</DIAGNOSTICO>
    <MEDICO_ASIGNADO COLEGIADO='67890'>Dr. Gomez</MEDICO_ASIGNADO>
    <HABITACION NUMEROCAMA="12" NUMEROHABITACION="101"></HABITACION>
</PACIENTE>
</HOSPITAL>
